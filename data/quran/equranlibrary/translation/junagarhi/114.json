{"surah":114,"ayahs":[{"numberInSurah":1,"arabicText":"قُلْ اَعُوْذُ بِرَبِّ النَّاسِۙ","translation":"آپ کہہ دیجئے! کہ میں لوگوں کے پروردگار کی پناه میں آتا ہوں"},{"numberInSurah":2,"arabicText":"مَلِكِ النَّاسِۙ","translation":"لوگوں کے مالک کی (اور)"},{"numberInSurah":3,"arabicText":"اِلٰهِ النَّاسِۙ","translation":"لوگوں کے معبود کی (پناه میں)"},{"numberInSurah":4,"arabicText":"مِنْ شَرِّ الْوَسْوَاسِ١ۙ۬ الْخَنَّاسِ۪ۙ","translation":"وسوسہ ڈالنے والے پیچھے ہٹ جانے والے کے شر سے"},{"numberInSurah":5,"arabicText":"الَّذِیْ یُوَسْوِسُ فِیْ صُدُوْرِ النَّاسِۙ","translation":"جو لوگوں کے سینوں میں وسوسہ ڈالتا ہے"},{"numberInSurah":6,"arabicText":"مِنَ الْجِنَّةِ وَ النَّاسِ۠ ۧ","translation":"(خواه) وه جن میں سے ہو یا انسان میں سے"}]}