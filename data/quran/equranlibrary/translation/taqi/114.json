{"surah":114,"ayahs":[{"numberInSurah":1,"arabicText":"قُلْ اَعُوْذُ بِرَبِّ النَّاسِۙ","translation":"کہو کہ : میں پناہ مانگتا ہوں سب لوگوں کے پروردگار کی۔"},{"numberInSurah":2,"arabicText":"مَلِكِ النَّاسِۙ","translation":"سب لوگوں کے بادشاہ کی۔"},{"numberInSurah":3,"arabicText":"اِلٰهِ النَّاسِۙ","translation":"سب لوگوں کے معبود کی۔"},{"numberInSurah":4,"arabicText":"مِنْ شَرِّ الْوَسْوَاسِ١ۙ۬ الْخَنَّاسِ۪ۙ","translation":"اس وسوسہ ڈالنے والے کے شر سے جو پیچھے کو چھپ جاتا ہے۔"},{"numberInSurah":5,"arabicText":"الَّذِیْ یُوَسْوِسُ فِیْ صُدُوْرِ النَّاسِۙ","translation":"جو لوگوں کے دلوں میں وسوسہ ڈالتا ہے۔"},{"numberInSurah":6,"arabicText":"مِنَ الْجِنَّةِ وَ النَّاسِ۠ ۧ","translation":"چاہے وہ جنات میں سے ہو، یا انسانوں میں سے۔"}]}