{"surah":101,"ayahs":[{"numberInSurah":1,"arabicText":"اَلْقَارِعَةُۙ","translation":"کھڑ کھڑانے والی"},{"numberInSurah":2,"arabicText":"مَا الْقَارِعَةُۚ","translation":"کھڑ کھڑانے والی کیا ہے؟"},{"numberInSurah":3,"arabicText":"وَ مَاۤ اَدْرٰىكَ مَا الْقَارِعَةُؕ","translation":"اور تم کیا جانوں کھڑ کھڑانے والی کیا ہے؟"},{"numberInSurah":4,"arabicText":"یَوْمَ یَكُوْنُ النَّاسُ كَالْفَرَاشِ الْمَبْثُوْثِۙ","translation":"(وہ قیامت ہے) جس دن لوگ ایسے ہوں گے جیسے بکھرے ہوئے پتنگے"},{"numberInSurah":5,"arabicText":"وَ تَكُوْنُ الْجِبَالُ كَالْعِهْنِ الْمَنْفُوْشِؕ","translation":"اور پہاڑ ایسے ہو جائیں گے جیسے دھنکی ہوئی رنگ برنگ کی اون"},{"numberInSurah":6,"arabicText":"فَاَمَّا مَنْ ثَقُلَتْ مَوَازِیْنُهٗۙ","translation":"تو جس کے (اعمال کے) وزن بھاری نکلیں گے"},{"numberInSurah":7,"arabicText":"فَهُوَ فِیْ عِیْشَةٍ رَّاضِیَةٍؕ","translation":"وہ دل پسند عیش میں ہو گا"},{"numberInSurah":8,"arabicText":"وَ اَمَّا مَنْ خَفَّتْ مَوَازِیْنُهٗۙ","translation":"اور جس کے وزن ہلکے نکلیں گے"},{"numberInSurah":9,"arabicText":"فَاُمُّهٗ هَاوِیَةٌؕ","translation":"اس کا مرجع ہاویہ ہے"},{"numberInSurah":10,"arabicText":"وَ مَاۤ اَدْرٰىكَ مَاهِیَهْؕ","translation":"اور تم کیا سمجھے کہ ہاویہ کیا چیز ہے؟"},{"numberInSurah":11,"arabicText":"نَارٌ حَامِیَةٌ۠ ۧ","translation":"دہکتی ہوئی آگ ہے"}]}