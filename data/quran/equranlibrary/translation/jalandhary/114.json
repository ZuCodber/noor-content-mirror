{"surah":114,"ayahs":[{"numberInSurah":1,"arabicText":"قُلْ اَعُوْذُ بِرَبِّ النَّاسِۙ","translation":"کہو کہ میں لوگوں کے پروردگار کی پناہ مانگتا ہوں"},{"numberInSurah":2,"arabicText":"مَلِكِ النَّاسِۙ","translation":"(یعنی) لوگوں کے حقیقی بادشاہ کی"},{"numberInSurah":3,"arabicText":"اِلٰهِ النَّاسِۙ","translation":"لوگوں کے معبود برحق کی"},{"numberInSurah":4,"arabicText":"مِنْ شَرِّ الْوَسْوَاسِ١ۙ۬ الْخَنَّاسِ۪ۙ","translation":"(شیطان) وسوسہ انداز کی برائی سے جو (خدا کا نام سن کر) پیچھے ہٹ جاتا ہے"},{"numberInSurah":5,"arabicText":"الَّذِیْ یُوَسْوِسُ فِیْ صُدُوْرِ النَّاسِۙ","translation":"جو لوگوں کے دلوں میں وسوسے ڈالتا ہے"},{"numberInSurah":6,"arabicText":"مِنَ الْجِنَّةِ وَ النَّاسِ۠ ۧ","translation":"وہ جنّات میں سے (ہو) یا انسانوں میں سے"}]}