{"surah":114,"ayahs":[{"numberInSurah":1,"arabicText":"قُلْ اَعُوْذُ بِرَبِّ النَّاسِۙ","translation":"کہو، میں پناہ مانگتا ہوں انسانوں کے رب"},{"numberInSurah":2,"arabicText":"مَلِكِ النَّاسِۙ","translation":"انسانوں کے بادشاہ"},{"numberInSurah":3,"arabicText":"اِلٰهِ النَّاسِۙ","translation":"انسانوں کے حقیقی معبود کی"},{"numberInSurah":4,"arabicText":"مِنْ شَرِّ الْوَسْوَاسِ١ۙ۬ الْخَنَّاسِ۪ۙ","translation":"اُس وسوسہ ڈالنے والے کے شر سے جو بار بار پلٹ کر آتا ہے"},{"numberInSurah":5,"arabicText":"الَّذِیْ یُوَسْوِسُ فِیْ صُدُوْرِ النَّاسِۙ","translation":"جو لوگوں کے دلوں میں وسوسے ڈالتا ہے"},{"numberInSurah":6,"arabicText":"مِنَ الْجِنَّةِ وَ النَّاسِ۠ ۧ","translation":"خواہ وہ جنوں میں سے ہو یا انسانوں میں سے"}]}