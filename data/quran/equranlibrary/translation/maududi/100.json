{"surah":100,"ayahs":[{"numberInSurah":1,"arabicText":"اَلْقَارِعَةُۙ","translation":"عظیم حادثہ!"},{"numberInSurah":2,"arabicText":"مَا الْقَارِعَةُۚ","translation":"کیا ہے وہ عظیم حادثہ؟"},{"numberInSurah":3,"arabicText":"وَ مَاۤ اَدْرٰىكَ مَا الْقَارِعَةُؕ","translation":"تم کیا جانو کہ وہ عظیم حادثہ کیا ہے؟"},{"numberInSurah":4,"arabicText":"یَوْمَ یَكُوْنُ النَّاسُ كَالْفَرَاشِ الْمَبْثُوْثِۙ","translation":"وہ دن جب لوگ بکھرے ہوئے پروانوں کی طرح"},{"numberInSurah":5,"arabicText":"وَ تَكُوْنُ الْجِبَالُ كَالْعِهْنِ الْمَنْفُوْشِؕ","translation":"اور پہاڑ رنگ برنگ کے دھنکے ہوئے اون کی طرح ہوں گے"},{"numberInSurah":6,"arabicText":"فَاَمَّا مَنْ ثَقُلَتْ مَوَازِیْنُهٗۙ","translation":"پھر جس کے پلڑے بھاری ہوں گے"},{"numberInSurah":7,"arabicText":"فَهُوَ فِیْ عِیْشَةٍ رَّاضِیَةٍؕ","translation":"وہ دل پسند عیش میں ہوگا"},{"numberInSurah":8,"arabicText":"وَ اَمَّا مَنْ خَفَّتْ مَوَازِیْنُهٗۙ","translation":"اور جس کے پلڑے ہلکے ہوں گے"},{"numberInSurah":9,"arabicText":"فَاُمُّهٗ هَاوِیَةٌؕ","translation":"اس کی جائے قرار گہری کھائی ہوگی"},{"numberInSurah":10,"arabicText":"وَ مَاۤ اَدْرٰىكَ مَاهِیَهْؕ","translation":"اور تمہیں کیا خبر کہ وہ کیا چیز ہے؟"},{"numberInSurah":11,"arabicText":"نَارٌ حَامِیَةٌ۠ ۧ","translation":"بھڑکتی ہوئی آگ"}]}